# =========================================================
#  METEORA BOT — rahasia & setelan instance (JANGAN commit)
#  Salin: cp .env.example .env  lalu isi nilainya.
#  Default strategi ada di strat.conf (di-commit ke git).
# =========================================================

# ===== Shared (wallet, RPC, API, telegram) =====
WALLET_PRIVATE_KEY=
RPC_URL=
HELIUS_API_KEY=
GMGN_API_KEY=
# Fallback: dipakai bila JUPITER_PRICE_API_KEY / JUPITER_SWAP_API_KEY kosong.
JUPITER_API_KEY=
# Key khusus polling harga (price/v3) — bucket kuota terpisah dari swap.
JUPITER_PRICE_API_KEY=
# Key khusus eksekusi swap (swap/v2) — tidak boleh terpakai polling harga.
JUPITER_SWAP_API_KEY=
# true = tidak mengirim transaksi nyata (uji coba)
DRY_RUN=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bot Telegram TERPISAH untuk antre entry (/entry). Jangan pakai token yang sama
# dengan TELEGRAM_BOT_TOKEN — satu bot cuma boleh satu konsumen getUpdates.
# Buat di @BotFather (/newbot), lalu tempel token di sini. Kosong = proses idle.
ENTRYBOT_TELEGRAM_TOKEN=
# Kosong = pakai TELEGRAM_CHAT_ID. Isi hanya kalau chat entry bot beda.
ENTRYBOT_TELEGRAM_CHAT_ID=

# ===== Entry manual bidask:sol =====
# Nilai yang dipakai bot ada di strat.conf (menang atas .env). Baris di bawah
# hanya dokumentasi default. Format pool.txt: CA,size,,bidask:sol,ca,HARGA
# HARGA: 0.0012 atau 0.0012usd = USD per token. 0.0000123sol = SOL per token.
# TVL minimum pool DLMM token/SOL saat harga entry tersentuh.
# BIDASK_SOL_ENTRY_MIN_TVL_USD=20000
# Lebar posisi maksimum (bin, inklusif: bawah + aktif + atas). Di atas ini pool dilewati.
# BIDASK_SOL_ENTRY_MAX_BINS=169
# Jarak harga di bawah bin aktif, persen (negatif).
# BIDASK_SOL_ENTRY_LOWER_PCT=-50
# Jarak harga di atas bin aktif, persen. Bin atas dibiarkan kosong.
# BIDASK_SOL_ENTRY_UPPER_PCT=15
