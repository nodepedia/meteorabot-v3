# =========================================================
#  METEORA BOT — semua pengaturan ada di file ini
# =========================================================

# ===== Shared (wallet, RPC, API, telegram) =====
WALLET_PRIVATE_KEY=
RPC_URL=
HELIUS_API_KEY=
GMGN_API_KEY=
# Fallback: dipakai bila JUPITER_PRICE_API_KEY / JUPITER_SWAP_API_KEY kosong.
JUPITER_API_KEY=
# Key khusus polling harga (price/v3) — bucket kuota terpisah dari swap.
JUPITER_PRICE_API_KEY=
# Key khusus eksekusi swap (swap/v2) — tidak boleh terpakai polling harga.
JUPITER_SWAP_API_KEY=
# true = tidak mengirim transaksi nyata (uji coba)
DRY_RUN=true
# true = PnL ditampilkan/dihitung dalam basis SOL
SOL_MODE=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Entry =====
# Aktifkan/nonaktifkan modul entry
ENTRY_ENABLED=true
# File daftar pool. Isi cukup alamat pool per baris (pakai default di bawah),
# atau `alamat,entry_size,max_position` untuk meng-override per pool.
POOL_LIST_FILE=pool.txt
# Default entry_size (SOL) & max_position untuk baris pool.txt yang hanya berisi
# alamat. Baris berisi `alamat,size,max` tetap menang. entry_size harus > 0.
ENTRY_DEFAULT_SIZE_SOL=0.2
ENTRY_DEFAULT_MAX_POSITION=1
# Refresh kandidat pool + posisi terbuka (detik), bukan cadence sinyal.
# Sensitivitas sinyal diatur oleh JUPITER_POLL_INTERVAL_SEC.
ENTRY_SCAN_INTERVAL_SEC=15
# Timeframe candle untuk Supertrend (gmgn resolution): 1m/5m/15m/1h/4h/1d
ENTRY_TIMEFRAME=15m
# Parameter Supertrend
ST_ATR_PERIOD=10
ST_MULTIPLIER=3
# Sinyal entry selalu bullish: held_pullback (default; close harus tetap di atas garis)
# | first_touch (entry begitu candle menyentuh garis bullish, abaikan close)
ENTRY_TOUCH_MODE=held_pullback
# Jika dalam X jam tidak entry, pool dinonaktifkan (baris diberi '#' otomatis)
ENTRY_EXPIRY_HOURS=6
# Ukuran entry (SOL) default lewat ENTRY_DEFAULT_SIZE_SOL; bisa di-override per
# pool dengan menulis `alamat,size,max` di pool.txt. Porsi sisi SOL (0.5 = rata:
# 1 SOL + 1 SOL setara token) — berlaku untuk semua pool
ENTRY_SIZE_SPLIT=0.5
# Rentang bin & strategi entry selalu fixed: BidAsk dua sisi, bin -34/+34.
# Slippage untuk initialize position (basis poin)
ENTRY_SLIPPAGE_BPS=1000
# Sisakan SOL untuk gas
GAS_RESERVE=0.05
# Pool dengan pair selain SOL (mis. -USDC) otomatis DITOLAK & dilewati + alert Telegram.
# Jeda (detik) sebelum pool dicoba lagi setelah entry gagal
ENTRY_FAILURE_COOLDOWN_SEC=300
# true = satu sinyal touch hanya diproses sekali (tidak retry di candle yang sama)
ENTRY_ONE_SHOT_PER_SIGNAL=true
# Nonaktifkan pool (beri '#' di pool.txt) + alert Telegram setelah entry gagal sebanyak ini berturut-turut
ENTRY_MAX_FAILURES=3

# ===== Fee entry (priority fee / Jito tip) =====
# none     = perilaku lama + kirim ulang otomatis (tanpa biaya tambahan)
# priority = sisipkan priority fee (ComputeBudget)
# jito     = bayar tip Jito (dikirim via Jito block engine)
# both     = priority fee + tip Jito
ENTRY_FEE_MODE=none
# Priority fee fixed (micro-lamports per compute unit). Hanya untuk mode priority/both.
ENTRY_PRIORITY_FEE_MICRO_LAMPORTS=50000
# Batas compute unit yang diminta (0 = biarkan SDK Meteora menentukan).
ENTRY_COMPUTE_UNIT_LIMIT=0
# Besar tip Jito (SOL). Hanya untuk mode jito/both.
ENTRY_JITO_TIP_SOL=0.001
# Hard cap estimasi biaya per entry (SOL). Fee melebihi ini -> entry dibatalkan + alert.
ENTRY_FEE_MAX_SOL=0.002
# Jumlah percobaan kirim ulang transaksi entry (blockhash baru tiap percobaan).
ENTRY_TX_RETRY_ATTEMPTS=5
# Batas tunggu konfirmasi tiap transaksi (detik).
ENTRY_TX_CONFIRM_TIMEOUT_SEC=30
# Interval kirim ulang (ms).
ENTRY_TX_RESEND_INTERVAL_MS=2000
# Mode jito/both: kirim juga ke RPC biasa (bukan hanya Jito) untuk peluang lebih tinggi.
ENTRY_DUAL_SEND=true
# Endpoint Jito block engine.
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Opsional: override daftar akun tip Jito (dipisah koma). Kosong = pakai bawaan.
JITO_TIP_ACCOUNTS=

# ===== DCA (averaging-down) =====
# Aktifkan DCA: entry baru di pool yang sama saat posisi menyentuh ambang arm
# lalu memantul dari titik terendah (kebalikan trailing TP).
DCA_ENABLED=true
# Ambang arm (poin PnL absolut). Contoh -10 = mulai memantau saat PnL <= -10%.
DCA_ARM_PCT=-10
# Besar pantulan dari trough untuk memicu DCA (poin absolut, mis. 1 = +1 poin).
DCA_REBOUND_PCT=1
# Maksimal total DCA per SESI (sejak posisi pertama dibuka sampai semua posisi
# di pool close). Persisten di state.dcaUsage; 1 = sekali, 2 = dua kali.
DCA_MAX_ADDS=1
# Cadence watcher DCA (detik): scan arm/trail + konfirmasi rebound memakai satu
# request PnL yang sama, terpisah dari loop exit. 5 = cek tiap 5 detik.
DCA_POLL_INTERVAL_SEC=5
# Ambang minimum (detik) sebelum rebound dikonfirmasi. Efektifnya = tick watcher.
DCA_CONFIRM_DELAY_SEC=5
# Backoff per-pool (detik) setelah eksekusi DCA gagal.
DCA_COOLDOWN_SEC=300

# ===== Telegram =====
# Interval status Telegram (menit)
TG_STATUS_INTERVAL=5

# ===== Swap / Sweep =====
# Swap otomatis token base → SOL setelah posisi ditutup
AUTO_SWAP_AFTER_CLOSE=true
# Slippage Jupiter (basis poin) — dipakai bila SWAP_USE_RTSE=false
SWAP_SLIPPAGE_BPS=100
# true = pakai RTSE Jupiter (estimasi slippage otomatis, mode ultra) untuk
# mengurangi gagal swap saat harga bergerak cepat; false = slippage tetap.
SWAP_USE_RTSE=false
# Jumlah percobaan swap (termasuk token-side saat entry)
SWAP_RETRY_ATTEMPTS=3
# Sisa token dengan nilai <= threshold (USD) dianggap dust dan dilewati
DUST_USD_THRESHOLD=0.5
# Mint yang TIDAK ikut di-sweep ke SOL (dipisah koma). Default: USDC.
SWEEP_EXCLUDE_MINTS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Jeda (detik) sebelum mint yang gagal di-swap dicoba lagi (backoff per-mint)
SWEEP_FAILURE_COOLDOWN_SEC=1800

# ===== Logs =====
# Level log PM2. info = naratif (ringkasan 5 menit + event penting + warning/error).
# debug = ikut menampilkan baris [detail] teknis (GMGN/Meteora/siklus, dll).
LOG_LEVEL=info
# Simpan file log harian (logs/meteorabot-YYYY-MM-DD.log) selama X hari,
# yang lebih tua dihapus otomatis saat bot start. 0 = nonaktif (tanpa hapus).
LOG_RETENTION_DAYS=7
# Log PM2 (logs/out.log, logs/error.log) dirotasi via: npm run pm2:logrotate

# ===== Exit — umum =====
# Candle timeframe untuk indikator exit
TIMEFRAME=15m
# Interval cek saat ada posisi (menit; 0.2 = 12 detik)
POLL_INTERVAL_HOLD=0.2
# Interval cek saat tidak ada posisi (menit)
POLL_INTERVAL_IDLE=5
# Jumlah siklus berturut-turut posisi tidak terbaca on-chain sebelum
# dianggap sudah ditutup manual (bot kirim alert Telegram).
MISSING_CYCLE_THRESHOLD=5
# Ambang span bin untuk mengklasifikasikan posisi sebagai bidask
BIN_THRESHOLD=80
VOLUME_CANDLE_COUNT=5
VOLUME_TIMEFRAME=5m
# --- Data layer ---
# TF native (5m/1h/4h/24h) diambil dari Meteora. TF 15m tidak tersedia di Meteora,
# jadi diambil dari GMGN (native 15m) supaya cocok dengan chart.
CANDLE_15M_SOURCE=gmgn
# Lama cache candle untuk TF native (detik).
CANDLE_CACHE_TTL_SEC=60
# Jeda (detik) setelah bar 15m tutup sebelum request data baru, supaya bar
# baru sudah terbentuk dan bar yang baru tutup sudah final.
CANDLE_CLOSE_DELAY_SEC=3
# Batas permintaan GMGN per menit (free tier praktis ~5/menit; sisakan margin).
GMGN_MAX_PER_MIN=4
# Jarak minimum antar permintaan GMGN (detik) — mencegah burst.
GMGN_MIN_GAP_SEC=15
# Jika garis Supertrend tak ter-update selama ini (menit), entry pool itu dimatikan.
GMGN_MAX_STALE_MIN=30
# Bila GMGN gagal, fallback ke 15m sintetis Meteora (false = jangan, lebih aman).
GMGN_FALLBACK_TO_METEORA=false
# Batas permintaan Meteora per menit.
METEORA_MAX_PER_MIN=120

# --- Sinyal entry (GMGN 15m + Jupiter) ---
# Interval poll harga Jupiter (detik). 1 request batch untuk semua pool.
# Limit price/v3 ~10 req/10s (~1 req/s); 2 = aman (~5 req/10s), jangan di bawah 1.
JUPITER_POLL_INTERVAL_SEC=2
# Toleransi sentuh garis (%). 0 = entry tepat saat harga <= garis.
ENTRY_TOUCH_TOLERANCE_PCT=0
# File cache garis Supertrend (agar restart tidak warmup ulang).
SUPERTREND_CACHE_FILE=supertrend-cache.json
# Waktu konfirmasi (detik) sebelum exit trailing TP dieksekusi (hindari wick).
# Drop trailing = max(peak * TRAILING_DROP_RATIO_PCT%, TRAILING_DROP_PCT).
# Rasio adaptif untuk peak besar; floor menjaga peak rendah dari exit karena noise.
# Berlaku untuk trailing TP peak (>= TRAILING_TRIGGER_PCT) maupun trailing dari
# sinyal indikator (RSI+BB / RSI+BB wick / RSI+MACD).
TRAILING_CONFIRM_DELAY_SEC=10

# OOR kanan selalu close langsung untuk semua mode (tanpa setting).

# ===== Exit — Bidask Double-Side (token + SOL, span < BIN_THRESHOLD) =====
BIDASK_DOUBLE_ENABLE_STOP_LOSS=false
BIDASK_DOUBLE_STOP_LOSS_PCT=-90
BIDASK_DOUBLE_ENABLE_OOR=false
BIDASK_DOUBLE_OOR_KIRI_MINUTES=60
BIDASK_DOUBLE_ENABLE_INDICATORS=true
BIDASK_DOUBLE_RSI_PERIOD=2
BIDASK_DOUBLE_MACD_FAST=12
BIDASK_DOUBLE_MACD_SLOW=26
BIDASK_DOUBLE_MACD_SIGNAL=9
BIDASK_DOUBLE_BB_PERIOD=20
BIDASK_DOUBLE_BB_STDDEV=2
BIDASK_DOUBLE_TRAILING_TAKE_PROFIT=true
BIDASK_DOUBLE_TRAILING_TRIGGER_PCT=10
BIDASK_DOUBLE_TRAILING_DROP_RATIO_PCT=8
BIDASK_DOUBLE_TRAILING_DROP_PCT=1.5

# ===== Exit — Bidask Token-Only (posisi hanya base token, tanpa SOL) =====
BIDASK_TOKEN_ENABLE_STOP_LOSS=false
BIDASK_TOKEN_ENABLE_OOR=false
BIDASK_TOKEN_ENABLE_INDICATORS=true
BIDASK_TOKEN_RSI_PERIOD=2
BIDASK_TOKEN_MACD_FAST=12
BIDASK_TOKEN_MACD_SLOW=26
BIDASK_TOKEN_MACD_SIGNAL=9
BIDASK_TOKEN_BB_PERIOD=20
BIDASK_TOKEN_BB_STDDEV=2
BIDASK_TOKEN_TRAILING_TAKE_PROFIT=false
BIDASK_TOKEN_TRAILING_DROP_RATIO_PCT=8
BIDASK_TOKEN_TRAILING_DROP_PCT=1.5

# ===== Exit — Bidask Sol-Only (posisi hanya SOL) =====
BIDASK_SOL_ENABLE_STOP_LOSS=false
BIDASK_SOL_STOP_LOSS_PCT=-90
BIDASK_SOL_ENABLE_OOR=false
BIDASK_SOL_OOR_KIRI_MINUTES=60
BIDASK_SOL_ENABLE_INDICATORS=true
BIDASK_SOL_RSI_PERIOD=2
BIDASK_SOL_MACD_FAST=12
BIDASK_SOL_MACD_SLOW=26
BIDASK_SOL_MACD_SIGNAL=9
BIDASK_SOL_BB_PERIOD=20
BIDASK_SOL_BB_STDDEV=2
BIDASK_SOL_TRAILING_TAKE_PROFIT=true
BIDASK_SOL_TRAILING_TRIGGER_PCT=10
BIDASK_SOL_TRAILING_DROP_RATIO_PCT=8
BIDASK_SOL_TRAILING_DROP_PCT=1.5

# ===== Exit — Spot Double-Side (token + SOL, span >= BIN_THRESHOLD) =====
SPOT_DOUBLE_ENABLE_STOP_LOSS=false
SPOT_DOUBLE_ENABLE_OOR=false
SPOT_DOUBLE_ENABLE_INDICATORS=false
SPOT_DOUBLE_TRAILING_TAKE_PROFIT=true
SPOT_DOUBLE_TRAILING_TRIGGER_PCT=15
SPOT_DOUBLE_TRAILING_DROP_RATIO_PCT=8
SPOT_DOUBLE_TRAILING_DROP_PCT=1.5

# ===== Exit — Spot Token-Only (scaffold, rules menyusul) =====
SPOT_TOKEN_ENABLE_STOP_LOSS=false
SPOT_TOKEN_ENABLE_OOR=false
SPOT_TOKEN_ENABLE_INDICATORS=false
SPOT_TOKEN_TRAILING_TAKE_PROFIT=false

# ===== Exit — Spot Sol-Only (scaffold, rules menyusul) =====
SPOT_SOL_ENABLE_STOP_LOSS=false
SPOT_SOL_ENABLE_OOR=false
SPOT_SOL_ENABLE_INDICATORS=false
SPOT_SOL_TRAILING_TAKE_PROFIT=false
