# =========================================================
#  METEORA BOT — rahasia & setelan instance (JANGAN commit)
#  Salin: cp .env.example .env  lalu isi nilainya.
#  Default strategi ada di strat.conf (di-commit ke git).
# =========================================================

# ===== Shared (wallet, RPC, API, telegram) =====
WALLET_PRIVATE_KEY=
RPC_URL=
HELIUS_API_KEY=
GMGN_API_KEY=
# Fallback: dipakai bila JUPITER_PRICE_API_KEY / JUPITER_SWAP_API_KEY kosong.
JUPITER_API_KEY=
# Key khusus polling harga (price/v3) — bucket kuota terpisah dari swap.
JUPITER_PRICE_API_KEY=
# Key khusus eksekusi swap (swap/v2) — tidak boleh terpakai polling harga.
JUPITER_SWAP_API_KEY=
# true = tidak mengirim transaksi nyata (uji coba)
DRY_RUN=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Runner Alert scanner (worker meteorabot-runner) =====
# Key terpisah dari bot utama agar kuota LP tidak terganggu.
SCANNER_GMGN_API_KEY=
SCANNER_RPC_URL=
# Runner di VPS terpisah (kosongkan MAIN_VPS_HOST = mode lokal)
MAIN_VPS_HOST=
MAIN_VPS_SSH_KEY=~/.ssh/id_ed25519
MAIN_POOL_PATH=~/grokbot/meteorabot-v3/pool.txt
MAIN_STATE_PATH=
GMGN_WALLETS_DIR=
# Jeda minimal antar RPC runner (ms). 150 = ~6.6 req/s (aman Helius free 10 rps)
RUNNER_RPC_MIN_GAP_MS=150
